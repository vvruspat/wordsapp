{
	"name": "mobile",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"postinstall": "patch-package",
		"prepare": "husky",
		"dev": "expo start -c",
		"dev:ios": "expo run:ios --device",
		"build:ios": "eas build --platform ios",
		"build:android": "eas build --platform android",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
		"test": "node --test tests/*.test.cjs",
		"precommit": "lint-staged && npm run typecheck"
	},
	"lint-staged": {
		"*": [
			"biome format --write --no-errors-on-unmatched",
			"biome lint --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@assistant-ui/metro": "^0.0.17",
		"@assistant-ui/react-native": "^0.1.48",
		"@expo/vector-icons": "^15.1.1",
		"@lovesworking/watermelondb-expo-plugin-sdk-52-plus": "^1.0.3",
		"@nozbe/watermelondb": "^0.28.0",
		"@react-native-community/netinfo": "12.0.1",
		"@sentry/react-native": "^8.31.0",
		"@storybook/react-native": "^10.7.0",
		"@vvruspat/words-types": "^1.1.0",
		"assistant-cloud": "^0.2.7",
		"dotenv": "^18.0.8",
		"expo": "^58.0.16",
		"expo-asset": "~58.0.17",
		"expo-audio": "~58.0.9",
		"expo-blur": "~58.0.5",
		"expo-constants": "~58.0.12",
		"expo-dev-client": "~58.0.14",
		"expo-file-system": "~58.0.10",
		"expo-font": "~58.0.9",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.16",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.13",
		"expo-localization": "~58.0.5",
		"expo-navigation-bar": "~58.0.4",
		"expo-router": "~58.0.24",
		"expo-secure-store": "~58.0.2",
		"expo-splash-screen": "~58.0.10",
		"expo-status-bar": "~58.0.3",
		"expo-symbols": "~58.0.4",
		"expo-system-ui": "~58.0.6",
		"expo-web-browser": "~58.0.6",
		"i18next": "^26.5.3",
		"immer": "^11.1.21",
		"jwt-decode": "^4.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-i18next": "^17.1.0",
		"react-native": "0.88.0",
		"react-native-config": "^1.7.2",
		"react-native-country-flag": "^2.0.2",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "~0.21.4",
		"react-native-worklets": "0.13.0",
		"react-server-dom-webpack": "19.3.1",
		"storybook": "^10.6.2",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@storybook/react-native-web-vite": "^10.6.2",
		"@types/react": "~19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"baseline-browser-mapping": "^2.11.29",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"patch-package": "^8.0.1",
		"postinstall-postinstall": "^2.1.0",
		"react-test-renderer": "19.3.1",
		"typescript": "~6.0.3"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"exclude": [
					"@nozbe/watermelondb",
					"@nozbe/simdjson"
				]
			}
		},
		"install": {
			"exclude": [
				"@sentry/react-native",
				"react",
				"react-dom"
			]
		}
	},
	"private": true,
	"engines": {
		"node": "^22.22.1 || ^24.11.0 || >=26.0.0"
	}
}
