{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "expo start -c",
    "dev:ios": "expo run:ios --device",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome lint .",
    "format": "biome check . --write --unsafe"
  },
  "dependencies": {
    "@assistant-ui/metro": "^0.0.10",
    "@assistant-ui/react-native": "^0.1.38",
    "@expo/vector-icons": "^15.1.1",
    "@lovesworking/watermelondb-expo-plugin-sdk-52-plus": "^1.0.3",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "^8.27.0",
    "@storybook/react-native": "^10.2.3",
    "@vvruspat/words-types": "^1.1.0",
    "assistant-cloud": "^0.1.41",
    "dotenv": "^17.3.1",
    "expo": "^57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^25.10.9",
    "immer": "^11.1.4",
    "jwt-decode": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^16.6.6",
    "react-native": "0.86.3",
    "react-native-config": "^1.6.1",
    "react-native-country-flag": "^2.0.2",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "react-server-dom-webpack": "19.2.8",
    "storybook": "^10.2.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@storybook/react-native-web-vite": "^10.2.19",
    "@types/react": "~19.2.14",
    "baseline-browser-mapping": "^2.10.8",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "react-native-svg": "^15.15.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react",
        "react-dom"
      ]
    }
  },
  "private": true
}
